# Puerto del servidor
PORT=3000

# PostgreSQL (Neon)
# 1. Crea un proyecto gratis en https://neon.tech
# 2. Copia la connection string desde el dashboard
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# WhatsApp (número con código de país, sin + ni espacios)
WHATSAPP_NUMBER=573001234567
WHATSAPP_DISPLAY=+57 300 123 4567
PHONE=+57 300 123 4567

# Seguridad
SESSION_SECRET=cambia-esta-clave-por-una-segura
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
