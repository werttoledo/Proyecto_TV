<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary: #007bff;
            --accent: #ffd600;
            --danger: #dc3545;
            --success: #28a745;
            --table-bg: #f8f9fa;
            --table-border: #e3e6f0;
        }
        body {
            background: #f4f8fb;
            font-family: 'Segoe UI', Arial, sans-serif;
        }
        .admin-container {
            max-width: 1200px;
            margin: 50px auto;
            padding: 20px;
            background-color: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        }
        .admin-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 30px;
        }
        .admin-header .logo-title {
            display: flex;
            align-items: center;
        }
        .admin-header img {
            height: 48px;
            margin-right: 16px;
        }
        .admin-header h1 {
            color: var(--primary);
            margin: 0;
            font-size: 2.1rem;
            font-weight: 700;
            letter-spacing: 1px;
        }
        .admin-header .add-button {
            background: var(--primary);
            color: #fff;
            padding: 12px 28px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            font-size: 1.1em;
            box-shadow: 0 2px 8px rgba(0,123,255,0.08);
            transition: background 0.2s, box-shadow 0.2s;
            border: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .admin-header .add-button:hover {
            background: var(--accent);
            color: #222;
            box-shadow: 0 4px 16px rgba(0,123,255,0.12);
        }
        .product-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            background: var(--table-bg);
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }
        .product-table th, .product-table td {
            padding: 16px 12px;
            text-align: left;
        }
        .product-table th {
            background: var(--primary);
            color: #fff;
            font-size: 1.05em;
            font-weight: 600;
            border-bottom: 2px solid var(--table-border);
        }
        .product-table tr {
            transition: background 0.15s;
        }
        .product-table tr:hover {
            background: #e3f0ff;
        }
        .product-table td {
            border-bottom: 1px solid var(--table-border);
            vertical-align: middle;
        }
        .product-table img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 6px;
            border: 2px solid var(--accent);
            background: #fff;
        }
        .product-actions {
            display: flex;
            gap: 8px;
        }
        .product-actions .edit-button, .product-actions .delete-button {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 1em;
            font-weight: 500;
            border: none;
            border-radius: 5px;
            padding: 8px 16px;
            cursor: pointer;
            transition: background 0.2s, color 0.2s;
        }
        .product-actions .edit-button {
            background: var(--accent);
            color: #222;
        }
        .product-actions .edit-button:hover {
            background: #ffe066;
            color: var(--primary);
        }
        .product-actions .delete-button {
            background: var(--danger);
            color: #fff;
        }
        .product-actions .delete-button:hover {
            background: #b71c2b;
        }
        @media (max-width: 900px) {
            .admin-container { padding: 8px; }
            .product-table th, .product-table td { padding: 10px 6px; }
            .admin-header h1 { font-size: 1.3rem; }
        }
        @media (max-width: 600px) {
            .admin-header { flex-direction: column; align-items: flex-start; gap: 10px; }
            .product-table, .product-table thead, .product-table tbody, .product-table th, .product-table td, .product-table tr {
                display: block;
            }
            .product-table tr { margin-bottom: 18px; }
            .product-table td, .product-table th {
                padding: 8px 4px;
                text-align: right;
                position: relative;
            }
            .product-table td:before {
                content: attr(data-label);
                position: absolute;
                left: 0;
                width: 50%;
                padding-left: 8px;
                font-weight: bold;
                color: #007bff;
                text-align: left;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <div class="admin-container">
            <div class="admin-header">
                <div class="logo-title">
                    <img src="/images/logo_tv.png" alt="Logo Electromax">
                    <h1>Admin - Electromax</h1>
                </div>
                <a href="/admin/add" class="add-button"><i class="fa fa-plus"></i> Nuevo Producto</a>
            </div>

            <table class="product-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Brand</th>
                        <th>State</th>
                        <th>Featured</th>
                        <th>Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(product => { %>
                        <tr>
                            <td><img src="<%= product.imageUrl %>" alt="<%= product.name %>"></td>
                            <td><%= product.name %></td>
                            <td><%= product.brand %></td>
                            <td><%= product.state %></td>
                            <td><span style="font-weight:700; color:<%= product.featured ? '#0f6eff' : '#64748b' %>"><%= product.featured ? 'Sí' : 'No' %></span></td>
                            <td>$<%= product.price.toFixed(2) %></td>
                            <td class="product-actions">
                                <a href="/admin/edit/<%= product._id %>" class="edit-button"><i class="fa fa-pen"></i> Editar</a>
                                <form action="/admin/delete/<%= product._id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="delete-button"><i class="fa fa-trash"></i> Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </main>

    <footer>
        <p>&copy; <%= new Date().getFullYear() %> Electromax. Todos los derechos reservados.</p>
    </footer>

    <a href="<%= site.getWhatsAppUrl() %>"
       class="whatsapp-float"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="Contactar por WhatsApp">
        <i class="fab fa-whatsapp"></i>
        <span class="whatsapp-tooltip">¡Escríbenos!</span>
    </a>

    <script src="/js/main.js"></script>
</body>
</html> 