<header class="main-header">
    <nav class="nav-container">
        <div class="logo-area">
            <a href="/" class="logo-link">
                <div class="logo-icon"><i class="fas fa-bolt"></i></div>
                <span class="logo-text">Electromax</span>
            </a>
        </div>
        <button class="mobile-menu-btn" aria-label="Menú">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <ul class="nav-links">
            <li><a href="/" class="nav-link <%= path === '/' ? 'active' : '' %>">Inicio</a></li>
            <li><a href="/productos" class="nav-link <%= path === '/productos' ? 'active' : '' %>">Productos</a></li>
            <li><a href="/contacto" class="nav-link <%= path === '/contacto' ? 'active' : '' %>">Contacto</a></li>
            <% if (user) { %>
                <% if (user.role === 'admin') { %>
                    <li><a href="/admin" class="nav-link <%= path.startsWith('/admin') ? 'active' : '' %>">Admin</a></li>
                <% } %>
                <li><a href="/logout" class="nav-link">Cerrar Sesión</a></li>
            <% } else { %>
                <li><a href="/login" class="nav-link <%= path === '/login' ? 'active' : '' %>">Iniciar Sesión</a></li>
            <% } %>
        </ul>
    </nav>
</header>
