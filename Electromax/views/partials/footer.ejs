<footer class="main-footer">
    <div class="footer-content">
        <div class="footer-section">
            <div class="footer-brand">
                <div class="logo-icon logo-icon-sm"><i class="fas fa-bolt"></i></div>
                <h3>Electromax</h3>
            </div>
            <p><%= site.tagline %></p>
            <div class="social-links">
                <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                <a href="<%= site.getWhatsAppUrl() %>" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
            </div>
        </div>
        <div class="footer-section">
            <h3>Enlaces Rápidos</h3>
            <ul>
                <li><a href="/">Inicio</a></li>
                <li><a href="/productos">Productos</a></li>
                <li><a href="/contacto">Contacto</a></li>
                <li><a href="<%= site.getWhatsAppUrl() %>" target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
            </ul>
        </div>
        <div class="footer-section">
            <h3>Contacto</h3>
            <ul class="contact-info clean-contact">
                <li>
                    <i class="fas fa-map-marker-alt"></i>
                    <a href="<%= site.mapsUrl %>" target="_blank" rel="noopener noreferrer"><%= site.address %></a>
                </li>
                <li>
                    <i class="fas fa-phone"></i>
                    <a href="tel:<%= site.phone.replace(/\s/g, '') %>"><%= site.phone %></a>
                </li>
                <li>
                    <i class="fab fa-whatsapp"></i>
                    <a href="<%= site.getWhatsAppUrl() %>" target="_blank" rel="noopener noreferrer"><%= site.whatsappDisplay %></a>
                </li>
                <li>
                    <i class="fas fa-clock"></i>
                    <span><%= site.schedule %></span>
                </li>
            </ul>
        </div>
        <div class="footer-section footer-map-block">
            <h3>Estamos ubicados</h3>
            <div class="footer-map map-box">
                <iframe src="https://www.google.com/maps?q=CL+23+24A+09+LC2+Barrio+Catatumbo,+Villavicencio,+Meta&output=embed" width="100%" height="140" style="border:0; border-radius:10px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Ubicación Electromax"></iframe>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> Electromax. Todos los derechos reservados.</p>
    </div>
</footer>

<a href="<%= site.getWhatsAppUrl() %>"
   class="whatsapp-float"
   target="_blank"
   rel="noopener noreferrer"
   aria-label="Contactar por WhatsApp">
    <i class="fab fa-whatsapp"></i>
    <span class="whatsapp-tooltip">¡Escríbenos!</span>
</a>

<script src="/js/main.js"></script>
