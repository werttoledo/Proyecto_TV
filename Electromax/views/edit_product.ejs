<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Admin form specific styles - similar to add_product.ejs */
        .form-container {
            max-width: 480px;
            margin: 40px auto;
            padding: 32px 28px 24px 28px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.10);
        }
        .form-logo {
            text-align: center;
            margin-bottom: 18px;
        }
        .form-logo img {
            height: 48px;
        }
        .form-container h1 {
            color: #007bff;
            text-align: center;
            margin-bottom: 30px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #007bff;
        }
        .form-group input[type="text"],
        .form-group input[type="number"],
        .form-group input[type="file"] {
            width: 100%;
            padding: 12px;
            border: 1.5px solid #ddd;
            border-radius: 6px;
            font-size: 1em;
            box-sizing: border-box;
            transition: border 0.2s;
        }
        .form-group input:focus {
            border-color: #007bff;
            outline: none;
            box-shadow: 0 0 5px rgba(0,123,255,0.10);
        }
        .form-actions {
            text-align: center;
            margin-top: 30px;
        }
        .btn-main {
            background: #007bff;
            color: #fff;
            padding: 12px 32px;
            border: none;
            border-radius: 6px;
            font-size: 1.1em;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s;
            margin-right: 12px;
        }
        .btn-main:hover {
            background: #ffd600;
            color: #222;
        }
        .back-link {
            color: #007bff;
            text-decoration: none;
            font-weight: bold;
            margin-left: 10px;
            transition: color 0.2s;
        }
        .back-link:hover {
            color: #ffd600;
        }
        @media (max-width: 600px) {
            .form-container { padding: 12px 4px; }
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <div class="form-container">
            <div class="form-logo" style="text-align:center; margin-bottom:18px;">
                <img src="/images/logo_tv.png" alt="Logo Electromax" style="height:48px;">
            </div>
            <h1 style="color:#007bff; text-align:center; margin-bottom:30px;">Editar Producto</h1>
            <form action="/admin/edit/<%= product._id %>" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="name">Name:</label>
                    <input type="text" id="name" name="name" value="<%= product.name %>" required>
                </div>
                <div class="form-group">
                    <label for="brand">Brand:</label>
                    <input type="text" id="brand" name="brand" value="<%= product.brand %>">
                </div>
                <div class="form-group">
                    <label for="state">State:</label>
                    <input type="text" id="state" name="state" value="<%= product.state %>">
                </div>
                <div class="form-group">
                    <label for="price">Price:</label>
                    <input type="number" id="price" name="price" step="0.01" value="<%= product.price %>" required>
                </div>
                <div class="form-group">
                    <label>Current Image:</label><br>
                    <% if (product.imageUrl) { %>
                        <img src="<%= product.imageUrl %>" alt="Imagen actual" style="max-width:120px; max-height:120px; border-radius:4px;">
                    <% } else { %>
                        <span>No image</span>
                    <% } %>
                </div>
                <div class="form-group">
                    <label for="imageUrl">Ruta de imagen local o URL:</label>
                    <input type="text" id="imageUrl" name="imageUrl" value="<%= product.imageUrl %>" placeholder="/images/mi-producto.jpg o https://...">
                    <small>Ejemplo: <code>/images/mi-producto.jpg</code></small>
                </div>
                <div class="form-group">
                    <label for="image">Subir nueva imagen:</label>
                    <input type="file" id="image" name="image">
                </div>
                <div class="form-group">
                    <label for="featured">
                        <input type="checkbox" id="featured" name="featured" <%= product.featured ? 'checked' : '' %>>
                        Marcar como producto destacado
                    </label>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-main">Actualizar</button>
                    <a href="/admin" class="back-link">Volver al Admin</a>
                </div>
            </form>
        </div>
    </main>

    <footer>
        <p>&copy; 2025 Electromax. Todos los derechos reservados.</p>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html> 