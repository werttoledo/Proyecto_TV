<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Productos - Electromax</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <section class="hero-products">
            <div class="hero-content">
                <h1><%= title %></h1>
            </div>
        </section>

        <section class="products-section">
            <div class="filters-container">
                <div class="filter-group">
                    <label for="brand">Marca</label>
                    <select id="brand" name="brand">
                        <option value="all">Todas las marcas</option>
                        <!-- Add options dynamically if needed -->
                    </select>
                </div>
                <div class="filter-group">
                    <label for="state">Estado</label>
                    <select id="state" name="state">
                        <option value="all">Todos los estados</option>
                        <!-- Add options dynamically if needed -->
                    </select>
                </div>
                <div class="filter-group">
                    <label for="sort">Ordenar por</label>
                    <select id="sort" name="sort">
                        <option value="recent">Más recientes</option>
                        <!-- Add options dynamically if needed -->
                    </select>
                </div>
                <div class="filter-buttons">
                    <button class="btn btn-primary">Filtrar</button>
                    <button class="btn btn-secondary">Limpiar filtros</button>
                </div>
            </div>

            <div class="product-grid">
                <% if (products && products.length > 0) { %>
                    <% products.forEach(product => { %>
                        <div class="product-card">
                            <div class="product-image">
                                <img src="<%= product.imageUrl %>" alt="<%= product.name %>" onerror="this.src='/images/default-product.svg'">
                                <span class="product-badge"><%= product.state %></span>
                            </div>
                            <div class="product-details">
                                <span class="product-category"><%= product.brand %> - <%= product.name.split(' ')[0] %></span>
                                <h3><%= product.name %></h3>
                                <p class="product-description"><%= product.description %></p>
                                <div class="product-meta">
                                    <span class="product-state"><i class="fas fa-tag"></i> <%= product.state %></span>
                                </div>
                                <div class="product-price-btn">
                                    <span class="product-price">$<%= product.price.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                                    <a href="/productos/<%= product._id %>" class="btn btn-primary">Ver detalles</a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p>No hay productos disponibles en este momento.</p>
                <% } %>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html> 